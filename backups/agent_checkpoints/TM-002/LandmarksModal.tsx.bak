import React, { useState } from 'react';
import {
  StyleSheet,
  View,
  Text,
  Modal,
  TouchableOpacity,
  ScrollView,
} from 'react-native';
import { MapTheme } from '@/core/theme/mapThemes';
import { LandmarkDiscoveryStatus, RegionalLandmark } from '@/core/geo/regionalLandmarks';
import { UserStats } from '@/services/storage';
import { RegionalExplorationStats } from '@/services/regionalMetrics';

interface LandmarksModalProps {
  visible: boolean;
  onClose: () => void;
  theme: MapTheme;
  landmarks: LandmarkDiscoveryStatus[];
  stats: UserStats;
  regionalStats?: RegionalExplorationStats;
  onSelectLandmark?: (landmark: RegionalLandmark) => void;
}

export const LandmarksModal: React.FC<LandmarksModalProps> = ({
  visible,
  onClose,
  theme,
  landmarks,
  stats,
  regionalStats,
  onSelectLandmark,
}) => {
  const [filterCategory, setFilterCategory] = useState<'all' | 'discovered' | 'pending'>('all');
  const isLight = theme.mode === 'light';

  const discoveredCount = landmarks.filter((l) => l.isDiscovered).length;
  const totalCount = landmarks.length;

  const filteredLandmarks = landmarks.filter((item) => {
    if (filterCategory === 'discovered') return item.isDiscovered;
    if (filterCategory === 'pending') return !item.isDiscovered;
    return true;
  });

  return (
    <Modal visible={visible} transparent animationType="slide" onRequestClose={onClose}>
      <View style={styles.backdrop}>
        <View
          style={[
            styles.modalCard,
            {
              backgroundColor: isLight ? '#ffffff' : '#0c101d',
              borderColor: isLight ? '#e2e8f0' : 'rgba(255, 255, 255, 0.12)',
            },
          ]}
        >
          {/* Header */}
          <View style={styles.header}>
            <View>
              <Text style={[styles.headerSubtitle, { color: isLight ? '#64748b' : '#94a3b8' }]}>
                CATÁLOGO REGIONAL
              </Text>
              <Text style={[styles.title, { color: isLight ? '#0f172a' : '#ffffff' }]}>
                Lugares & Monumentos
              </Text>
            </View>
            <TouchableOpacity onPress={onClose} style={styles.closeBtn} activeOpacity={0.7}>
              <Text style={[styles.closeText, { color: isLight ? '#64748b' : '#94a3b8' }]}>✕</Text>
            </TouchableOpacity>
          </View>

          {/* Tarjeta de Progreso Metropolitano */}
          <View
            style={[
              styles.progressCard,
              {
                backgroundColor: isLight ? '#f8fafc' : 'rgba(255, 255, 255, 0.03)',
                borderColor: isLight ? '#e2e8f0' : 'rgba(255, 255, 255, 0.08)',
              },
            ]}
          >
            <View style={styles.progressRow}>
              <View style={styles.metricCol}>
                <Text style={[styles.metricVal, { color: theme.accentColor }]}>
                  {discoveredCount} / {totalCount}
                </Text>
                <Text style={[styles.metricLbl, { color: isLight ? '#64748b' : '#94a3b8' }]}>
                  LUGARES
                </Text>
              </View>

              <View style={styles.metricDivider} />

              <View style={styles.metricCol}>
                <Text style={[styles.metricVal, { color: isLight ? '#0f172a' : '#ffffff' }]}>
                  {regionalStats ? regionalStats.cityFormatted : `${((stats.totalAreaKm2 / 1485) * 100).toFixed(2)}%`}
                </Text>
                <Text style={[styles.metricLbl, { color: isLight ? '#64748b' : '#94a3b8' }]}>
                  CIUDAD DE MÉXICO
                </Text>
              </View>

              <View style={styles.metricDivider} />

              <View style={styles.metricCol}>
                <Text style={[styles.metricVal, { color: isLight ? '#0f172a' : '#ffffff' }]}>
                  {stats.totalHexagons}
                </Text>
                <Text style={[styles.metricLbl, { color: isLight ? '#64748b' : '#94a3b8' }]}>
                  SECTORES
                </Text>
              </View>
            </View>
          </View>

          {/* Filtros Limpios */}
          <View style={styles.filterRow}>
            {[
              { id: 'all', label: 'Todos' },
              { id: 'discovered', label: `Descubiertos (${discoveredCount})` },
              { id: 'pending', label: `Por descubrir (${totalCount - discoveredCount})` },
            ].map((f) => {
              const isSelected = filterCategory === f.id;
              return (
                <TouchableOpacity
                  key={f.id}
                  style={[
                    styles.filterPill,
                    {
                      backgroundColor: isSelected
                        ? theme.accentColor
                        : (isLight ? '#f1f5f9' : 'rgba(255, 255, 255, 0.05)'),
                      borderColor: isSelected ? theme.accentColor : (isLight ? '#e2e8f0' : 'rgba(255, 255, 255, 0.08)'),
                    },
                  ]}
                  onPress={() => setFilterCategory(f.id as any)}
                  activeOpacity={0.8}
                >
                  <Text
                    style={[
                      styles.filterPillText,
                      {
                        color: isSelected
                          ? (isLight ? '#ffffff' : '#0b0f19')
                          : (isLight ? '#475569' : '#cbd5e1'),
                        fontWeight: isSelected ? '700' : '500',
                      },
                    ]}
                  >
                    {f.label}
                  </Text>
                </TouchableOpacity>
              );
            })}
          </View>

          {/* Lista de Monumentos */}
          <ScrollView style={styles.list} showsVerticalScrollIndicator={false}>
            {filteredLandmarks.map(({ landmark, isDiscovered, distanceMeters }) => {
              const distanceKm = (distanceMeters / 1000).toFixed(1);
              return (
                <View
                  key={landmark.id}
                  style={[
                    styles.landmarkCard,
                    {
                      backgroundColor: isLight ? '#f8fafc' : 'rgba(255, 255, 255, 0.03)',
                      borderColor: isDiscovered
                        ? (isLight ? '#10b981' : 'rgba(16, 185, 129, 0.4)')
                        : (isLight ? '#e2e8f0' : 'rgba(255, 255, 255, 0.08)'),
                    },
                  ]}
                >
                  <View style={styles.landmarkTop}>
                    <View style={styles.landmarkTitleGroup}>
                      <Text
                        style={[
                          styles.landmarkName,
                          { color: isLight ? '#0f172a' : '#ffffff' },
                        ]}
                      >
                        {landmark.name}
                      </Text>
                      <Text
                        style={[
                          styles.landmarkCategory,
                          { color: isLight ? '#64748b' : '#94a3b8' },
                        ]}
                      >
                        {landmark.categoryLabel}
                      </Text>
                    </View>

                    <View
                      style={[
                        styles.statusBadge,
                        {
                          backgroundColor: isDiscovered
                            ? (isLight ? 'rgba(16, 185, 129, 0.1)' : 'rgba(16, 185, 129, 0.2)')
                            : (isLight ? '#f1f5f9' : 'rgba(255, 255, 255, 0.06)'),
                          borderColor: isDiscovered ? '#10b981' : (isLight ? '#cbd5e1' : 'rgba(255, 255, 255, 0.12)'),
                        },
                      ]}
                    >
                      <Text
                        style={[
                          styles.statusBadgeText,
                          { color: isDiscovered ? '#10b981' : (isLight ? '#64748b' : '#94a3b8') },
                        ]}
                      >
                        {isDiscovered ? 'Descubierto' : `A ${distanceKm} km`}
                      </Text>
                    </View>
                  </View>

                  <Text
                    style={[
                      styles.landmarkDesc,
                      { color: isLight ? '#475569' : '#cbd5e1' },
                    ]}
                  >
                    {landmark.description}
                  </Text>
                </View>
              );
            })}
          </ScrollView>

          {/* Botón Inferior */}
          <TouchableOpacity
            style={[styles.closeModalBtn, { backgroundColor: theme.accentColor }]}
            onPress={onClose}
            activeOpacity={0.85}
          >
            <Text
              style={[
                styles.closeModalBtnText,
                { color: isLight ? '#ffffff' : '#0b0f19' },
              ]}
            >
              Cerrar
            </Text>
          </TouchableOpacity>
        </View>
      </View>
    </Modal>
  );
};

const styles = StyleSheet.create({
  backdrop: {
    flex: 1,
    backgroundColor: 'rgba(0, 0, 0, 0.72)',
    justifyContent: 'flex-end',
  },
  modalCard: {
    width: '100%',
    maxHeight: '90%',
    borderTopLeftRadius: 24,
    borderTopRightRadius: 24,
    borderTopWidth: 1,
    paddingHorizontal: 20,
    paddingTop: 16,
    paddingBottom: 24,
  },
  header: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
    paddingBottom: 12,
  },
  headerSubtitle: {
    fontSize: 10,
    fontWeight: '800',
    letterSpacing: 1,
  },
  title: {
    fontSize: 20,
    fontWeight: '800',
    marginTop: 2,
    letterSpacing: -0.2,
  },
  closeBtn: {
    width: 32,
    height: 32,
    borderRadius: 16,
    backgroundColor: 'rgba(255, 255, 255, 0.08)',
    justifyContent: 'center',
    alignItems: 'center',
  },
  closeText: {
    fontSize: 15,
    fontWeight: '600',
  },
  progressCard: {
    paddingVertical: 12,
    borderRadius: 14,
    borderWidth: 1,
    marginTop: 8,
    marginBottom: 10,
  },
  progressRow: {
    flexDirection: 'row',
    justifyContent: 'space-around',
    alignItems: 'center',
  },
  metricCol: {
    alignItems: 'center',
  },
  metricVal: {
    fontSize: 15,
    fontWeight: '800',
  },
  metricLbl: {
    fontSize: 9,
    fontWeight: '700',
    letterSpacing: 0.5,
    marginTop: 2,
  },
  metricDivider: {
    width: 1,
    height: 24,
    backgroundColor: 'rgba(255, 255, 255, 0.1)',
  },
  filterRow: {
    flexDirection: 'row',
    gap: 6,
    marginBottom: 12,
  },
  filterPill: {
    flex: 1,
    paddingVertical: 7,
    borderRadius: 12,
    borderWidth: 1,
    alignItems: 'center',
    justifyContent: 'center',
  },
  filterPillText: {
    fontSize: 11,
  },
  list: {
    maxHeight: 380,
  },
  landmarkCard: {
    padding: 14,
    borderRadius: 16,
    borderWidth: 1,
    marginBottom: 10,
  },
  landmarkTop: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'flex-start',
    marginBottom: 8,
  },
  landmarkTitleGroup: {
    flex: 1,
    marginRight: 10,
  },
  landmarkName: {
    fontSize: 14,
    fontWeight: '700',
  },
  landmarkCategory: {
    fontSize: 11,
    fontWeight: '500',
    marginTop: 2,
  },
  statusBadge: {
    paddingHorizontal: 8,
    paddingVertical: 3,
    borderRadius: 10,
    borderWidth: 1,
  },
  statusBadgeText: {
    fontSize: 10,
    fontWeight: '700',
  },
  landmarkDesc: {
    fontSize: 12,
    lineHeight: 17,
  },
  closeModalBtn: {
    height: 48,
    borderRadius: 14,
    justifyContent: 'center',
    alignItems: 'center',
    marginTop: 12,
  },
  closeModalBtnText: {
    fontSize: 14,
    fontWeight: '800',
  },
});
